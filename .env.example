# Shopify checkout integration (server-only; never prefix these with VITE_)
SHOPIFY_STORE_DOMAIN=your-store.myshopify.com
SHOPIFY_STOREFRONT_API_VERSION=2026-07
SHOPIFY_STOREFRONT_ACCESS_TOKEN=replace-with-storefront-token

# One Shopify product variant per VisualSkin pack.
# Values must be Shopify variant GIDs, e.g. gid://shopify/ProductVariant/1234567890
SHOPIFY_VARIANT_CARCASA=gid://shopify/ProductVariant/REPLACE
SHOPIFY_VARIANT_CARCASA_POLERA=gid://shopify/ProductVariant/REPLACE
SHOPIFY_VARIANT_CARCASA_POLERON=gid://shopify/ProductVariant/REPLACE
SHOPIFY_VARIANT_CARCASA_POLERA_POLERON=gid://shopify/ProductVariant/REPLACE

# Shopify app client secret used to verify orders/paid webhooks.
SHOPIFY_WEBHOOK_SECRET=replace-with-shopify-app-client-secret
